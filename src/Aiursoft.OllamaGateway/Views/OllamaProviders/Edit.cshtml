@using Aiursoft.OllamaGateway.Entities
@model Aiursoft.OllamaGateway.Models.OllamaProvidersViewModels.CreateViewModel

<div class="container-fluid p-0">
    <div class="row mb-3">
        <div class="col-auto">
            <h1 class="h3 mb-3">@Localizer["Edit Provider"]</h1>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 col-xl-5 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">@Localizer["Provider Connection Settings"]</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" asp-route-id="@ViewData["Id"]" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">@Localizer["Provider Name"]</label>
                            <input asp-for="Name" class="form-control" placeholder="@Localizer["e.g. Local Server"]" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ProviderType" class="form-label">@Localizer["Provider Type"]</label>
                            <select asp-for="ProviderType" id="providerTypeSelect" class="form-select">
                                <option value="0">@Localizer["Ollama"]</option>
                                <option value="1">@Localizer["OpenAI Compatible"]</option>
                            </select>
                        </div>

                        <div id="openAiProtocolOptions" class="mb-3 @(Model.ProviderType == ProviderType.OpenAI ? string.Empty : "d-none")">
                            <label class="form-label">@Localizer["Supported OpenAI generation protocols"]</label>
                            <button type="button" class="btn btn-sm btn-link text-muted" data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-placement="auto" data-bs-container="body"
                                    aria-label="@Localizer["About generation protocols"]" data-bs-content="@Localizer["Matching client protocols are forwarded directly. Other supported requests are translated."]">
                                <i class="align-middle" data-lucide="circle-help" aria-hidden="true" style="width: 16px; height: 16px;"></i>
                            </button>
                            @if (ViewData["OpenAiProtocolsInferred"] as bool? == true)
                            {
                                <div class="alert alert-warning small" role="note">
                                    <div class="alert-message">
                                        @Localizer["These values were inferred from legacy backend settings. Saving this provider makes them explicit."]
                                    </div>
                                </div>
                            }
                            <div class="form-check">
                                <input asp-for="SupportsOpenAiChatCompletions" class="form-check-input" />
                                <label asp-for="SupportsOpenAiChatCompletions" class="form-check-label">
                                    <code>/v1/chat/completions</code> @Localizer["(Chat Completions)"]
                                </label>
                            </div>
                            <div class="form-check">
                                <input asp-for="SupportsOpenAiResponses" class="form-check-input" />
                                <label asp-for="SupportsOpenAiResponses" class="form-check-label">
                                    <code>/v1/responses</code> @Localizer["(Responses)"]
                                </label>
                            </div>
                            <span asp-validation-for="SupportsOpenAiChatCompletions" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="BaseUrl" class="form-label">@Localizer["Base URL"]</label>
                            <input asp-for="BaseUrl" class="form-control" id="baseUrl" placeholder="http://localhost:11434" />
                            <span asp-validation-for="BaseUrl" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="BearerToken" class="form-label">@Localizer["Bearer Token"]</label>
                            <input asp-for="BearerToken" class="form-control" id="bearerToken" type="password" placeholder="@Localizer["Optional API Key"]" />
                            <span asp-validation-for="BearerToken" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="KeepAlive" class="form-label">@Localizer["Keep Alive Policy"]</label>
                            <button type="button" class="btn btn-sm btn-link text-muted" data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-placement="auto" data-bs-container="body"
                                    aria-label="@Localizer["About model retention"]" data-bs-content="@Localizer["Keeps model weights loaded after the last request. Use 0 to unload immediately or -1 to keep them loaded. Ollama ignores invalid duration formats."]">
                                <i class="align-middle" data-lucide="circle-help" aria-hidden="true" style="width: 16px; height: 16px;"></i>
                            </button>
                            <input asp-for="KeepAlive" class="form-control" placeholder="5m" />
                            <div class="form-text">@Localizer["Ollama only; include a unit, e.g. 5m."]</div>
                            <span asp-validation-for="KeepAlive" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MaxParallelism" class="form-label">@Localizer["Max Concurrent Requests"]</label>
                            <button type="button" class="btn btn-sm btn-link text-muted" data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-placement="auto" data-bs-container="body"
                                    aria-label="@Localizer["About concurrent requests"]" data-bs-content="@Localizer["Limits simultaneous requests to this provider. Use 1 to process them one at a time. Waiting for a slot has no timeout and does not use the virtual model response timeout; disconnecting the client cancels the wait."]">
                                <i class="align-middle" data-lucide="circle-help" aria-hidden="true" style="width: 16px; height: 16px;"></i>
                            </button>
                            <input asp-for="MaxParallelism" class="form-control" type="number" min="0" max="1000" />
                            <div class="form-text">@Localizer["0 = unlimited."]</div>
                            <span asp-validation-for="MaxParallelism" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="HealthCheckTimeoutSeconds" class="form-label">@Localizer["Health Check Timeout (s)"]</label>
                            <button type="button" class="btn btn-sm btn-link text-muted" data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-placement="auto" data-bs-container="body"
                                    aria-label="@Localizer["About health checks"]" data-bs-content="@Localizer["Timeout for background model and status checks. Increase it for slow storage."]">
                                <i class="align-middle" data-lucide="circle-help" aria-hidden="true" style="width: 16px; height: 16px;"></i>
                            </button>
                            <input asp-for="HealthCheckTimeoutSeconds" class="form-control" type="number" min="1" max="3600" />
                            <span asp-validation-for="HealthCheckTimeoutSeconds" class="text-danger"></span>
                        </div>

                        <div id="testResult" class="mb-3" style="display:none;">
                            <div id="testContent"></div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="button" class="btn btn-outline-info me-md-2" id="btnTestConnection">@Localizer["Test Connection"]</button>
                            <a asp-action="Index" class="btn btn-outline-secondary me-md-2">@Localizer["Back to List"]</a>
                            <button type="submit" class="btn btn-primary">@Localizer["Save Changes"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-12 col-xl-7 mb-4">
            @if (Model.ProviderType == ProviderType.OpenAI)
            {
                <div class="card">
                    <div class="card-body">
                        <p class="text-muted mb-0">
                            <i class="align-middle me-1" data-feather="info"></i>
                            @Localizer["Warmup is not applicable to OpenAI-compatible providers. The upstream service manages model loading automatically."]
                        </p>
                    </div>
                </div>
            }
            else
            {
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">@Localizer["Proactive Model Warmup"]</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small">
                        @Localizer["Select physical models that should be proactively kept loaded in this provider's VRAM. The gateway will periodically ping these models to prevent them from being unloaded."]
                    </p>
                </div>
                <div class="table-responsive">
                    @Html.AntiForgeryToken()
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>@Localizer["Model"]</th>
                                <th style="width: 80px;">@Localizer["Keep"]</th>
                                <th style="width: 80px;">@Localizer["Embed"]</th>
                                <th>@Localizer["Advanced Warmup Options"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var physicalModels = (ViewData["PhysicalModels"] as IEnumerable<string>)?.ToList();
                                var warmupModels = ViewData["WarmupModels"] as List<WarmupModel> ?? new List<WarmupModel>();
                            }
                            @if (physicalModels == null || !physicalModels.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-3">@Localizer["No physical models found on this server."]</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var m in physicalModels)
                                {
                                    var warmupModel = warmupModels.FirstOrDefault(wm => wm.Name == m);
                                    var isEnabled = warmupModel != null;
                                    <tr data-model-name="@m">
                                        <td class="align-middle"><code>@m</code></td>
                                        <td class="align-middle">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input warmup-toggle" type="checkbox"
                                                       checked="@(isEnabled ? "checked" : null)" 
                                                       data-model-name="@m">
                                            </div>
                                        </td>
                                        <td class="align-middle">
                                            <div class="form-check form-switch embed-toggle @(isEnabled ? "" : "d-none")">
                                                <input class="form-check-input warmup-option" type="checkbox" title="@Localizer["Embedding model"]"
                                                       checked="@(warmupModel?.IsEmbedding == true ? "checked" : null)"
                                                       data-model-name="@m">
                                            </div>
                                        </td>
                                        <td>
                                            <div class="options-container @(isEnabled ? "" : "d-none") @(warmupModel?.IsEmbedding == true ? "d-none" : "")">
                                                <div class="row g-2">
                                                    <div class="col-md-6 col-lg-3">
                                                        <div class="input-group input-group-sm">
                                                            <span class="input-group-text">@Localizer["Ctx"]</span>
                                                            <input type="number" class="form-control warmup-numctx warmup-option" title="@Localizer["Context size"]" placeholder="4096" value="@warmupModel?.NumCtx" data-model-name="@m">
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-lg-3">
                                                        <div class="input-group input-group-sm">
                                                            <span class="input-group-text">@Localizer["Timeout (s)"]</span>
                                                            <input type="number" class="form-control warmup-timeout warmup-option" title="@Localizer["Warmup timeout"]" placeholder="1800" value="@warmupModel?.TimeoutSeconds" data-model-name="@m">
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            } @* end else (Ollama warmup section) *@
        </div>
        

    </div>
</div>

<!-- Localization and server-rendered data for JavaScript -->
<div id="provider-edit-data"
     data-provider-id="@ViewData["Id"]"
     data-test-url="@Url.Action("Test")"
     data-toggle-warmup-url="@Url.Action("ToggleWarmup", new { id = ViewData["Id"] })"
     data-update-warmup-url="@Url.Action("UpdateWarmupOptions", new { id = ViewData["Id"] })"
     hidden>
    <span data-key="connecting">@Localizer["Connecting..."]</span>
    <span data-key="connected-models">@Localizer["Connected! Found {0} models."].Value</span>
    <span data-key="error-prefix">@Localizer["Error: "]</span>
    <span data-key="toggle-failed">@Localizer["Failed to toggle warmup. Please try again."]</span>
    <span data-key="unexpected-error">@Localizer["An error occurred. Please check the browser console."]</span>
</div>

@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script>
        const providerEditData = document.getElementById('provider-edit-data');
        function getLocalizedText(key, defaultText) {
            const el = providerEditData.querySelector(`span[data-key="${key}"]`);
            return el ? el.innerText : defaultText;
        }

        const providerTypeSelect = document.getElementById('providerTypeSelect');
        const openAiProtocolOptions = document.getElementById('openAiProtocolOptions');
        providerTypeSelect.addEventListener('change', function () {
            openAiProtocolOptions.classList.toggle('d-none', this.value !== '1');
        });

        async function testConnection() {
            const baseUrl = document.getElementById('baseUrl').value;
            const bearerToken = document.getElementById('bearerToken').value;
            const resultDiv = document.getElementById('testResult');
            const contentDiv = document.getElementById('testContent');
            
            resultDiv.style.display = 'block';
            contentDiv.innerHTML = '<div class="text-center"><div class="spinner-border spinner-border-sm text-primary" role="status"></div> <span></span></div>';
            contentDiv.querySelector('span').innerText = getLocalizedText('connecting', 'Connecting...');
            
            try {
                const response = await fetch(providerEditData.dataset.testUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ providerId: parseInt(providerEditData.dataset.providerId), baseUrl, bearerToken, providerType: parseInt(providerTypeSelect?.value ?? '0') })
                });
                const data = await response.json();
                
                if (data.success) {
                    contentDiv.innerHTML = '<div class="alert alert-success mb-0" role="alert"><div class="alert-message"><i class="align-middle me-2" data-feather="check-circle"></i><span></span></div></div>';
                    contentDiv.querySelector('span').innerText = getLocalizedText('connected-models', 'Connected! Found {0} models.')
                        .replace('{0}', data.models.length);
                    if (window.feather) window.feather.replace();
                } else {
                    contentDiv.innerHTML = '<div class="alert alert-danger mb-0" role="alert"><div class="alert-message"><i class="align-middle me-2" data-feather="alert-triangle"></i><span></span></div></div>';
                    contentDiv.querySelector('span').innerText = data.message;
                    if (window.feather) window.feather.replace();
                }
            } catch (e) {
                contentDiv.innerHTML = '<div class="alert alert-danger mb-0" role="alert"><div class="alert-message"></div></div>';
                contentDiv.querySelector('.alert-message').innerText = getLocalizedText('error-prefix', 'Error: ') + e.message;
            }
        }

        async function toggleWarmup(event, modelName) {
            const isChecked = event.target.checked;
            const row = event.target.closest('tr');
            const optionsContainer = row.querySelector('.options-container');
            const embedToggle = row.querySelector('.embed-toggle');
            
            // UI optimistic update
            if (isChecked) {
                optionsContainer.classList.remove('d-none');
                embedToggle.classList.remove('d-none');
            } else {
                optionsContainer.classList.add('d-none');
                embedToggle.classList.add('d-none');
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const formData = new FormData();
            formData.append('modelName', modelName);
            
            try {
                const response = await fetch(providerEditData.dataset.toggleWarmupUrl, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    body: formData
                });
                
                if (!response.ok) {
                    alert(getLocalizedText('toggle-failed', 'Failed to toggle warmup. Please try again.'));
                    // Revert UI
                    event.target.checked = !isChecked;
                    if (!isChecked) { optionsContainer.classList.remove('d-none'); embedToggle.classList.remove('d-none'); }
                    else { optionsContainer.classList.add('d-none'); embedToggle.classList.add('d-none'); }
                }
            } catch (e) {
                console.error('Failed to toggle warmup:', e);
                alert(getLocalizedText('unexpected-error', 'An error occurred. Please check the browser console.'));
                // Revert UI
                event.target.checked = !isChecked;
                if (!isChecked) { optionsContainer.classList.remove('d-none'); embedToggle.classList.remove('d-none'); }
                else { optionsContainer.classList.add('d-none'); embedToggle.classList.add('d-none'); }
            }
        }

        async function updateOptions(event, modelName) {
            const row = event.target.closest('tr');
            const nCtxInput = row.querySelector('.warmup-numctx');
            const timeoutInput = row.querySelector('.warmup-timeout');
            const embedCheckbox = row.querySelector('.embed-toggle input[type="checkbox"]');
            const optionsContainer = row.querySelector('.options-container');
            const isEmbed = embedCheckbox ? embedCheckbox.checked : false;

            // Toggle visibility of chat options based on embedding state
            if (isEmbed) {
                optionsContainer.classList.add('d-none');
            } else {
                optionsContainer.classList.remove('d-none');
            }

            const nCtx = nCtxInput?.value;
            const timeoutSeconds = timeoutInput?.value;

            const formData = new FormData();
            formData.append('modelName', modelName);
            formData.append('isEmbedding', isEmbed);
            if (nCtx) formData.append('numCtx', nCtx);
            if (timeoutSeconds) formData.append('timeoutSeconds', timeoutSeconds);
            
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            
            // Visual feedback
            event.target.classList.remove('is-valid', 'is-invalid');
            
            try {
                const response = await fetch(providerEditData.dataset.updateWarmupUrl, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    body: formData
                });
                
                if (response.ok) {
                    event.target.classList.add('is-valid');
                    setTimeout(() => event.target.classList.remove('is-valid'), 2000);
                } else {
                    event.target.classList.add('is-invalid');
                }
            } catch (e) {
                console.error('Failed to update options:', e);
                event.target.classList.add('is-invalid');
            }
        }

        document.getElementById('btnTestConnection').addEventListener('click', testConnection);
        document.querySelectorAll('.warmup-toggle').forEach(function (input) {
            input.addEventListener('change', function (event) {
                toggleWarmup(event, input.dataset.modelName);
            });
        });
        document.querySelectorAll('.warmup-option').forEach(function (input) {
            input.addEventListener('change', function (event) {
                updateOptions(event, input.dataset.modelName);
            });
        });
    </script>
}
