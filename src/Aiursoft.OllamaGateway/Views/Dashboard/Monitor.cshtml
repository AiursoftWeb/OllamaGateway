@model Aiursoft.OllamaGateway.Models.DashboardViewModels.MonitorViewModel
@using Aiursoft.OllamaGateway.Entities
@using System.Text
@using Aiursoft.OllamaGateway.Gateway
@using System.Net

@{
    // Build a deduplicated map of physical nodes keyed by (ProviderId, ModelName).
    // When multiple virtual models share the same physical backend we only render it once.
    var physicalNodeMap = new Dictionary<(int ProviderId, string ModelName), VirtualModelBackend>();
    foreach (var vm in Model.VirtualModels)
    {
        foreach (var backend in vm.VirtualModelBackends)
        {
            var key = (backend.ProviderId, backend.UnderlyingModelName);
            if (!physicalNodeMap.TryGetValue(key, out var existing) || backend.Id < existing.Id)
                physicalNodeMap[key] = backend;
        }
    }

    // Produce a stable, Mermaid-safe node ID for a physical backend.
    string PhysNodeId(int providerId, string modelName) =>
        $"Phys_P{providerId}_B{physicalNodeMap[(providerId, modelName)].Id}";

    var routeDetails = new Dictionary<int, string>();
    string MermaidText(string value) => WebUtility.HtmlEncode(value).Replace("&quot;", "#quot;");

    var sb = new StringBuilder();
    sb.AppendLine("graph LR");
    sb.AppendLine("    %% Define global style classes");
    sb.AppendLine("    classDef gateway fill:#2d3748,stroke:#1a202c,stroke-width:2px,color:#fff,rx:8px,ry:8px;");
    sb.AppendLine("    classDef virtualSvc fill:#4a5568,stroke:#2d3748,stroke-width:2px,color:#fff,rx:5px,ry:5px;");
    sb.AppendLine("    ");
    sb.AppendLine("    %% Define backend node status colors");
    sb.AppendLine("    classDef ready fill:#38a169,stroke:#276749,stroke-width:2px,color:#fff,rx:15px,ry:15px;");
    sb.AppendLine("    classDef healthy fill:#3182ce,stroke:#2b6cb0,stroke-width:2px,color:#fff,rx:15px,ry:15px;");
    sb.AppendLine("    classDef down fill:#e53e3e,stroke:#c53030,stroke-width:2px,color:#fff,rx:15px,ry:15px;");
    sb.AppendLine("    classDef banned fill:#805ad5,stroke:#553c9a,stroke-width:2px,color:#fff,rx:15px,ry:15px;");
    sb.AppendLine("    ");
    sb.AppendLine("    classDef algo fill:#edf2f7,stroke:#a0aec0,stroke-width:1px,color:#4a5568,stroke-dasharray: 5 5;");
    sb.AppendLine("    classDef client fill:#f7fafc,stroke:#cbd5e0,stroke-width:2px,color:#2d3748,rx:20px,ry:20px;");

    sb.AppendLine();
    sb.AppendLine($"    Client([\"🌐 {Localizer["External Traffic (Client)"].Value}\"]):::client");
    sb.AppendLine();
    sb.AppendLine($"    subgraph LB_Core [{Localizer["Core Load Balancer Gateway"].Value}]");
    sb.AppendLine($"        Gateway{{\"🛡️ {Localizer["Load Balancer"].Value}<br/>(Gateway)\"}}:::gateway");

    foreach (var vm in Model.VirtualModels)
    {
        sb.AppendLine();
        sb.AppendLine($"        subgraph VS_{vm.Id} [{Localizer["Virtual Service"].Value} {vm.Name}]");
        var modelType = vm.Type == ModelType.Chat ? Localizer["Chat"].Value : Localizer["Embedding"].Value;
        var svcLabel = $"📦 {vm.Name}<br/>({modelType})";
        sb.AppendLine($"            Svc_{vm.Id}(\"{svcLabel}\"):::virtualSvc");
        sb.AppendLine($"            class Svc_{vm.Id} traffic-Svc_{vm.Id};");
        if (Model.BusyModels.Contains(vm.Name))
            sb.AppendLine($"            class Svc_{vm.Id} virtualSvcBusy;");
        var algoStr = vm.SelectionStrategy switch
        {
            SelectionStrategy.PriorityFallback => Localizer["Priority Fallback"].Value,
            SelectionStrategy.WeightedRandom => Localizer["Weighted Random"].Value,
            SelectionStrategy.RoundRobin => Localizer["Round Robin"].Value,
            _ => Localizer["Unknown"].Value
        };
        sb.AppendLine($"            Algo_{vm.Id}[\"⚖️ {algoStr}\"]:::algo");
        sb.AppendLine($"            Svc_{vm.Id} policy_{vm.Id}@--- Algo_{vm.Id}");
        sb.AppendLine("        end");
    }
    sb.AppendLine("    end");

    // Render one subgraph per provider, containing only the unique physical models for that provider.
    var byProvider = physicalNodeMap.GroupBy(kv => kv.Key.ProviderId);
    foreach (var providerGroup in byProvider)
    {
        var providerName = providerGroup.First().Value.Provider?.Name ?? Localizer["Provider {0}", providerGroup.Key].Value;
        sb.AppendLine();
        sb.AppendLine($"    subgraph PhysPool_P{providerGroup.Key} [{Localizer["Backend Pool"].Value} {providerName}]");
        foreach (var kv in providerGroup)
        {
            var backend = kv.Value;
            var nodeId = PhysNodeId(kv.Key.ProviderId, kv.Key.ModelName);
            
            var matchingBackends = Model.VirtualModels
                .SelectMany(m => m.VirtualModelBackends)
                .Where(b => b.ProviderId == kv.Key.ProviderId && b.UnderlyingModelName == kv.Key.ModelName)
                .ToList();
            var banTimes = matchingBackends.Select(b => Model.BackendBanStatuses.GetValueOrDefault(b.Id)).ToList();
            var isBanned = banTimes.Any(t => t.HasValue && t.Value > DateTime.UtcNow);

            var statusClass = isBanned ? "banned" : backend.IsReady ? "ready" : (backend.IsHealthy ? "healthy" : "down");
            var icon = isBanned ? "🚫" : backend.IsReady ? "🟢" : (backend.IsHealthy ? "🔵" : "🔴");
            var statusText = isBanned
                ? Localizer["Banned"].Value
                    : backend.IsReady
                        ? Localizer["Ready"].Value
                        : backend.IsHealthy
                            ? Localizer["Healthy"].Value
                            : Localizer["Down"].Value;
            
            var healthLabel = $"<span class='topology-health'>{MermaidText(statusText)}</span>";
            sb.AppendLine($"        {nodeId}[(\"{icon} {providerName}<br/>{backend.UnderlyingModelName}<br/>{healthLabel}\")]:::{statusClass}");
            sb.AppendLine($"        class {nodeId} traffic-{nodeId};");
            if (!isBanned && Model.BusyPhysicalModels.Contains(kv.Key))
                sb.AppendLine($"        class {nodeId} physicalBusy;");
        }
        sb.AppendLine("    end");
    }

    // Handle virtual models that have no backends at all.
    foreach (var vm in Model.VirtualModels.Where(v => !v.VirtualModelBackends.Any()))
    {
        sb.AppendLine();
        sb.AppendLine($"    subgraph Pool_Empty_{vm.Id} [{Localizer["Backend Pool"].Value} {vm.Name}]");
        sb.AppendLine($"        Empty_{vm.Id}[\"{Localizer["No Backend Nodes"].Value}\"]:::down");
        sb.AppendLine("    end");
    }

    sb.AppendLine();
    sb.AppendLine($"    Client entry@==>|\"{Localizer["Entry Traffic"].Value}\"| Gateway");

    foreach (var vm in Model.VirtualModels)
    {
        sb.AppendLine($"    Gateway route_{vm.Id}@==>|\"{Localizer["Route"].Value}: {vm.Name}\"| Svc_{vm.Id}");

        foreach (var backend in vm.VirtualModelBackends)
        {
            var nodeId = PhysNodeId(backend.ProviderId, backend.UnderlyingModelName);
            var actionText = (backend.Enabled && backend.IsHealthy) ? Localizer["Dispatch Traffic"].Value : Localizer["Block Node"].Value;
            string thinking;
            string? depth = null;
            string details;
            if (vm.Type == ModelType.Embedding)
            {
                thinking = @Localizer["Thinking: not applicable"].Value;
                details = @Localizer["Embedding requests do not use thinking overrides."].Value;
            }
            else
            {
                IReadOnlyList<BackendProtocol> protocols;
                try
                {
                    protocols = BackendProtocolResolver.GetSupportedProtocols(backend);
                }
                catch (InvalidOperationException)
                {
                    protocols = [];
                }

                var native = protocols.Contains(BackendProtocol.OllamaNative);
                var effort = native
                    ? backend.OllamaThinkOverride?.ToString().ToLowerInvariant()
                    : backend.ReasoningEffortOverride;
                thinking = protocols.Count == 0
                    ? @Localizer["Thinking: unavailable"].Value
                    : string.IsNullOrWhiteSpace(effort)
                        ? @Localizer["Thinking: follow request"].Value
                        : string.Format(@Localizer["Thinking: force {0}"].Value, effort);
                if (!native && protocols.Count > 0)
                {
                    var switchText = backend.OpenAiThinkOverride.HasValue
                        ? string.Format(@Localizer["Thinking: force {0}"].Value, backend.OpenAiThinkOverride.Value.ToString().ToLowerInvariant())
                        : @Localizer["Thinking: follow request"].Value;
                    depth = string.IsNullOrWhiteSpace(effort)
                        ? @Localizer["Depth: follow request"].Value
                        : string.Format(@Localizer["Depth: force {0}"].Value, effort);
                    thinking = switchText;
                }
                var protocolNames = protocols.Count == 0
                    ? @Localizer["No supported protocol"].Value
                    : string.Join(" / ", protocols);
                var fields = string.Join(" / ", protocols.Select(protocol => protocol switch
                {
                    BackendProtocol.OllamaNative => "think",
                    BackendProtocol.OpenAiChatCompletions => "reasoning_effort",
                    BackendProtocol.OpenAiResponses => "reasoning.effort",
                    _ => ""
                }));
                if (!native && protocols.Count > 0)
                    fields = "chat_template_kwargs.enable_thinking / " + fields;
                var explanation = protocols.Count == 0
                    ? @Localizer["No request can be dispatched until a supported backend protocol is configured."].Value
                    : string.IsNullOrWhiteSpace(effort) && !backend.OpenAiThinkOverride.HasValue
                        ? @Localizer["No backend override. The client setting is forwarded or translated; when absent, the upstream default applies."].Value
                        : @Localizer["Overrides the client setting on each attempt, including same-dialect direct forwarding and cross-dialect translation."].Value;
                var policyDetails = depth == null ? thinking : $"{thinking}\n{depth}";
                details = string.Join("\n", policyDetails,
                    string.Format(@Localizer["Protocols: {0}"].Value, protocolNames),
                    string.Format(@Localizer["Outgoing fields: {0}"].Value, fields), explanation);
            }
            routeDetails[backend.Id] = details;
            var policyLabel = $"<span class='backend-route-thinking'>{MermaidText(thinking)}</span>";
            if (depth != null)
                policyLabel += $"<br/><span class='backend-route-thinking'>{MermaidText(depth)}</span>";
            var label = $"<span class='backend-route backend-route-{backend.Id}'>{MermaidText(actionText)}<br/>{policyLabel}</span>";
            sb.AppendLine($"    Algo_{vm.Id} dispatch_{backend.Id}@-.->|\"{label}\"| {nodeId}");
        }
    }

    var mermaidCode = sb.ToString();
}

@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="stylesheet" href="~/styles/monitor.css" asp-append-version="true" />
}

<div id="traffic-labels" hidden>
    <span data-key="busy">@Localizer["Busy"]</span>
    <span data-key="live">@Localizer["Live"]</span>
    <span data-key="paused">@Localizer["Paused"]</span>
    <span data-key="reconnecting">@Localizer["Reconnecting"]</span>
    <span data-key="replay">@Localizer["Replay"]</span>
    <span data-key="received">@Localizer["Received"]</span>
    <span data-key="selected">@Localizer["Selected backend"]</span>
    <span data-key="queued">@Localizer["Waiting for a slot"]</span>
    <span data-key="sent">@Localizer["Waiting for upstream"]</span>
    <span data-key="headers">@Localizer["Upstream responded"]</span>
    <span data-key="returning">@Localizer["Returning response"]</span>
    <span data-key="completed">@Localizer["Completed"]</span>
    <span data-key="cancelled">@Localizer["Cancelled"]</span>
    <span data-key="failed">@Localizer["Failed"]</span>
    <span data-key="answer">@Localizer["Answer"]</span>
    <span data-key="receiving">@Localizer["Receiving"]</span>
    <span data-key="loadingAnswer">@Localizer["Loading answer…"]</span>
    <span data-key="answerUnavailable">@Localizer["This answer is no longer available."]</span>
    <span data-key="answerLoadFailed">@Localizer["Could not load the answer."]</span>
    <span data-key="loadingQuestion">@Localizer["Loading question…"]</span>
    <span data-key="questionUnavailable">@Localizer["This question is no longer available."]</span>
    <span data-key="questionLoadFailed">@Localizer["Could not load the question."]</span>
    <span data-key="attemptFailed">@Localizer["Attempt failed"]</span>
</div>

<div id="backend-route-details" hidden>
    @foreach (var vm in Model.VirtualModels)
    {
        <span data-model="@vm.Id">@vm.Name</span>
        foreach (var backend in vm.VirtualModelBackends)
        {
            <span data-route="@backend.Id" data-physical="@PhysNodeId(backend.ProviderId, backend.UnderlyingModelName)">@backend.Provider?.Name / @backend.UnderlyingModelName</span>
        }
    }
    @foreach (var (backendId, details) in routeDetails)
    {
        <span data-backend-id="@backendId">@details</span>
    }
</div>

<div class="container-fluid p-0">
    <div class="row mb-2 mb-xl-3">
        <div class="col-auto d-none d-sm-block">
            <h3>@Model.PageTitle</h3>
        </div>
        <div class="col-auto ms-auto text-end mt-n1">
            <a href="javascript:location.reload()" class="btn btn-primary shadow-sm ms-1">
                <i class="align-middle" data-lucide="refresh-cw"></i>
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-12 d-flex">
            <div class="card flex-fill w-100">
                <div class="card-body">
                    <div id="traffic-controls" class="d-flex flex-wrap align-items-center gap-2 mb-2"
                         data-feed="@Url.Action("TrafficEvents", "Dashboard")"
                         data-answer-url="@Url.Action("TrafficAnswer", "Dashboard")"
                         data-question-url="@Url.Action("TrafficQuestion", "Dashboard")">
                        <span id="traffic-status" class="badge bg-secondary" role="status">@Localizer["Connecting"]</span>
                        <button id="traffic-back" type="button" class="btn btn-sm btn-outline-secondary">@Localizer["Replay 5 seconds"]</button>
                        <button id="traffic-pause" type="button" class="btn btn-sm btn-outline-secondary" aria-pressed="false">@Localizer["Pause"]</button>
                        <button id="traffic-live" type="button" class="btn btn-sm btn-outline-secondary">@Localizer["Go live"]</button>
                        <select id="traffic-request" class="form-select form-select-sm w-auto" aria-label="@Localizer["Follow request"]">
                            <option value="">@Localizer["All requests"]</option>
                        </select>
                        <button id="traffic-question" type="button" class="btn btn-sm btn-outline-secondary" hidden>@Localizer["View full question"]</button>
                    </div>
                    <div id="traffic-detail" class="small mb-2" hidden></div>
                    <pre id="traffic-topology" class="mermaid" style="overflow: auto; min-height: 500px;">
@mermaidCode
                    </pre>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12 d-flex">
            @await Component.InvokeAsync("LiveInference")
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12 d-flex">
            @await Component.InvokeAsync("RecentRequests")
        </div>
    </div>
</div>

@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script type="module" src="~/js/monitor.js" asp-append-version="true"></script>
}
