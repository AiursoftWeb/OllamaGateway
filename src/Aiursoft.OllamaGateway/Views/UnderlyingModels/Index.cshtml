@model Aiursoft.OllamaGateway.Models.UnderlyingModelsViewModels.IndexViewModel
@using Aiursoft.WebTools
@using Aiursoft.OllamaGateway.Entities

<div class="container-fluid p-0">
    <div class="row mb-3">
        <div class="col-auto">
            <h1 class="h3 mb-3">@Localizer["Physical Models"]</h1>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <p class="text-muted mb-2">@Localizer["Models listed by each provider. Listing does not verify that a model can answer requests."]</p>
            <details class="small">
                <summary>@Localizer["About model status"]</summary>
                <dl class="mt-2 mb-0">
                    <dt>@Localizer["Listed"]</dt>
                    <dd>@Localizer["Reported by an OpenAI-compatible provider. Loading status, size and modification time are not provided."]</dd>
                    <dt>@Localizer["Running"] / @Localizer["Idle"]</dt>
                    <dd>@Localizer["Ollama reports the model as loaded or not loaded in memory."]</dd>
                    <dt>@Localizer["Unknown"]</dt>
                    <dd class="mb-0">@Localizer["The model is listed, but its loading status could not be retrieved."]</dd>
                </dl>
            </details>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                    <th>@Localizer["Name"]</th>
                    <th>@Localizer["Provider"]</th>
                    <th>@Localizer["Size"]</th>
                    <th>@Localizer["Usage"]</th>
                    <th>@Localizer["Total Calls"]</th>
                    <th>@Localizer["Modified"]</th>
                    <th>@Localizer["Actions"]</th>
                    </tr>
                    </thead>
                    <tbody>
                    @if (Model.Models.Count == 0)
                    {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            @Localizer["No physical models found. Check your providers connection."]
                        </td>
                    </tr>
                    }
                    else
                    {
                    @foreach (var m in Model.Models)
                    {
                        <tr>
                            <td>
                                <strong>@m.RawModel.Name</strong>
                                <div class="mt-1">
                                    @if (m.Provider.ProviderType == ProviderType.OpenAI)
                                    {
                                        <span class="badge bg-body-secondary text-body border">@Localizer["Listed"]</span>
                                    }
                                    else if (m.IsRunning == true)
                                    {
                                        <span class="badge bg-success">@Localizer["Running"]</span>
                                    }
                                    else if (m.IsRunning == false)
                                    {
                                        <span class="badge bg-body-secondary text-body border">@Localizer["Idle"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@Localizer["Unknown"]</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(m.RawModel.Digest))
                                {
                                    <small class="text-muted">@m.RawModel.Digest.Substring(0, Math.Min(12, m.RawModel.Digest.Length))...</small>
                                }
                            </td>
                            <td>
                                <span class="badge bg-secondary">@m.Provider.Name</span>
                                <br />
                                <small class="text-muted">@m.Provider.BaseUrl</small>
                            </td>
                            <td>
                                @if (m.Provider.ProviderType == ProviderType.OpenAI)
                                {
                                    <span class="text-muted">@Localizer["Not reported"]</span>
                                }
                                else
                                {
                                    <span>@(Math.Round(m.RawModel.Size / 1024.0 / 1024.0 / 1024.0, 2)) GB</span>
                                }
                            </td>
                            <td>
                                @if (m.UsedByVirtualModels.Any())
                                {
                                    @foreach (var vm in m.UsedByVirtualModels)
                                    {
                                        <span class="badge bg-subtle-primary text-primary border border-primary-subtle me-1">@vm.Name</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">@Localizer["Not used"]</span>
                                }
                            </td>
                            <td>@m.TotalCalls</td>
                            <td>
                                @if (m.Provider.ProviderType == ProviderType.OpenAI)
                                {
                                    <span class="text-muted">@Localizer["Not reported"]</span>
                                }
                                else
                                {
                                    <span data-utc-time="@m.RawModel.ModifiedAt.ToHtmlDateTime()"></span>
                                }
                            </td>
                            <td>
                                <a asp-controller="ChatPlayground" asp-action="PhysicalChat" asp-route-providerId="@m.Provider.Id" asp-route-modelName="@m.RawModel.Name" class="btn btn-sm btn-outline-primary">
                                    <i class="align-middle" data-lucide="message-square"></i> @Localizer["Chat"]
                                </a>
                            </td>
                        </tr>
                    }
                    }                </tbody>
            </table>
        </div>
    </div>
</div>
