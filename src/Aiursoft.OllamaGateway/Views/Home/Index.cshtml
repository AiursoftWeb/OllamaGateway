@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script>
        window.addEventListener('load', function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            var compatibilitySection = document.getElementById('compatibility-reference');
            if (!compatibilitySection) {
                return;
            }

            var sourceButtons = Array.from(compatibilitySection.querySelectorAll('[data-compatibility-source]'));
            var targetButtons = Array.from(compatibilitySection.querySelectorAll('[data-compatibility-target]'));
            var catalog = compatibilitySection.querySelector('[data-route-catalog]');
            var stage = compatibilitySection.querySelector('[data-compatibility-stage]');
            var selectedSource = 'ollama';
            var selectedTarget = 'ollama';

            function setHtml(selector, value) {
                compatibilitySection.querySelector(selector).innerHTML = value;
            }

            function updateButtonState(buttons, attribute, selectedValue) {
                buttons.forEach(function (button) {
                    var isActive = button.getAttribute(attribute) === selectedValue;
                    button.classList.toggle('active', isActive);
                    button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
                });
            }

            function renderRoute() {
                var direction = selectedSource + '-to-' + selectedTarget;
                var route = catalog.querySelector('[data-direction="' + direction + '"]');
                var sourceButton = compatibilitySection.querySelector('[data-compatibility-source="' + selectedSource + '"]');
                var targetButton = compatibilitySection.querySelector('[data-compatibility-target="' + selectedTarget + '"]');
                if (!route || !sourceButton || !targetButton) {
                    return;
                }

                var cells = route.children;
                var isTransparent = route.dataset.mode === 'transparent';
                var routeNumber = sourceButtons.indexOf(sourceButton) * targetButtons.length + targetButtons.indexOf(targetButton) + 1;

                updateButtonState(sourceButtons, 'data-compatibility-source', selectedSource);
                updateButtonState(targetButtons, 'data-compatibility-target', selectedTarget);
                stage.classList.toggle('state-transparent', isTransparent);
                stage.classList.toggle('state-translated', !isTransparent);

                setHtml('[data-route-number]', String(routeNumber).padStart(2, '0') + ' / 12');
                setHtml('[data-route-source-label]', sourceButton.dataset.label);
                setHtml('[data-route-source-endpoint]', sourceButton.dataset.endpoint);
                setHtml('[data-route-target-label]', targetButton.dataset.label);
                setHtml('[data-route-target-endpoint]', targetButton.dataset.endpoint);
                setHtml('[data-route-mode]', isTransparent ? stage.dataset.nativeLabel : stage.dataset.translatedLabel);
                setHtml('[data-route-summary]', isTransparent ? stage.dataset.nativeSummary : stage.dataset.translatedSummary);
                setHtml('[data-route-title]', sourceButton.dataset.label + ' → ' + targetButton.dataset.label);
                setHtml('[data-route-method]', cells[1].innerHTML);
                setHtml('[data-route-preserved]', cells[2].innerHTML);
                setHtml('[data-route-mapped]', cells[3].innerHTML);
                setHtml('[data-route-discarded]', cells[4].innerHTML);
                setHtml('[data-route-database]', cells[5].innerHTML);
            }

            sourceButtons.forEach(function (button) {
                button.addEventListener('click', function () {
                    selectedSource = button.dataset.compatibilitySource;
                    renderRoute();
                });
            });
            targetButtons.forEach(function (button) {
                button.addEventListener('click', function () {
                    selectedTarget = button.dataset.compatibilityTarget;
                    renderRoute();
                });
            });

            renderRoute();

            var embeddingSourceButtons = Array.from(compatibilitySection.querySelectorAll('[data-embedding-source]'));
            var embeddingTargetButtons = Array.from(compatibilitySection.querySelectorAll('[data-embedding-target]'));
            var embeddingCatalog = compatibilitySection.querySelector('[data-aux-route-catalog]');
            var embeddingStage = compatibilitySection.querySelector('[data-embedding-stage]');
            var selectedEmbeddingSource = 'openai-embedding';
            var selectedEmbeddingTarget = 'openai';

            function renderEmbeddingRoute() {
                var direction = selectedEmbeddingSource + '-to-' + selectedEmbeddingTarget;
                var route = embeddingCatalog.querySelector('[data-aux-route="' + direction + '"]');
                var sourceButton = compatibilitySection.querySelector('[data-embedding-source="' + selectedEmbeddingSource + '"]');
                var targetButton = compatibilitySection.querySelector('[data-embedding-target="' + selectedEmbeddingTarget + '"]');
                if (!route || !sourceButton || !targetButton) {
                    return;
                }

                var cells = route.children;
                var isTransparent = route.dataset.mode === 'transparent';
                var routeNumber = embeddingSourceButtons.indexOf(sourceButton) * embeddingTargetButtons.length + embeddingTargetButtons.indexOf(targetButton) + 1;

                updateButtonState(embeddingSourceButtons, 'data-embedding-source', selectedEmbeddingSource);
                updateButtonState(embeddingTargetButtons, 'data-embedding-target', selectedEmbeddingTarget);
                embeddingStage.classList.toggle('state-transparent', isTransparent);
                embeddingStage.classList.toggle('state-translated', !isTransparent);

                setHtml('[data-embedding-route-number]', String(routeNumber).padStart(2, '0') + ' / 04');
                setHtml('[data-embedding-source-label]', sourceButton.dataset.label);
                setHtml('[data-embedding-source-endpoint]', sourceButton.dataset.endpoint);
                setHtml('[data-embedding-target-label]', targetButton.dataset.label);
                setHtml('[data-embedding-target-endpoint]', targetButton.dataset.endpoint);
                setHtml('[data-embedding-mode]', isTransparent ? stage.dataset.nativeLabel : stage.dataset.translatedLabel);
                setHtml('[data-embedding-title]', sourceButton.dataset.label + ' → ' + targetButton.dataset.label);
                setHtml('[data-embedding-preserved]', cells[2].innerHTML);
                setHtml('[data-embedding-discarded]', cells[3].innerHTML);
                setHtml('[data-embedding-notes]', cells[4].innerHTML);
            }

            embeddingSourceButtons.forEach(function (button) {
                button.addEventListener('click', function () {
                    selectedEmbeddingSource = button.dataset.embeddingSource;
                    renderEmbeddingRoute();
                });
            });
            embeddingTargetButtons.forEach(function (button) {
                button.addEventListener('click', function () {
                    selectedEmbeddingTarget = button.dataset.embeddingTarget;
                    renderEmbeddingRoute();
                });
            });

            renderEmbeddingRoute();
        });
    </script>
}
