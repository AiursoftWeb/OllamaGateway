@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="stylesheet" href="~/styles/site.css" xmlns="http://www.w3.org/1999/html"/>
    <link rel="stylesheet" href="~/styles/marketing.css" xmlns="http://www.w3.org/1999/html"/>
}

<vc:marketing-navbar></vc:marketing-navbar>

<section class="landing-intro text-bg-dark pt-5 pt-lg-6 pb-5 pb-lg-7">
    <div class="landing-intro-content container h-100">
        <div class="row align-items-center h-100">
            <div class="col-lg-5 mx-auto">
                <span class="badge badge-subtle-primary p-1">@Localizer["Open Source"]</span>
                <span class="badge badge-subtle-primary p-1">@Localizer["Private AI"]</span>
                <span class="badge badge-subtle-primary p-1">@Localizer["MIT Licence"]</span>
                <h1 id="main-slogan" class="my-4 text-white" style="font-size: 3rem;">
                    @Localizer["Supercharge Your Native"] <span class='text-primary'>@Localizer["Ollama."]</span>
                </h1>
                <p class="text-lg text-white-50">@Localizer["Ollama Gateway: Supercharge your native Ollama with enterprise-grade API authentication, request auditing, rate limiting, and virtual model management—your secure, private AI gateway."]</p>
                <div class="my-4 d-flex gap-2 flex-wrap">
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary btn-lg btn-pill">
                        <i class="align-middle" data-lucide="grid"></i> @Localizer["Go to Dashboard"]
                    </a>
                    <a asp-controller="Home" asp-action="SelfHost" class="btn btn-outline-primary btn-lg btn-pill">
                        <i class="align-middle" data-lucide="server"></i> @Localizer["Deployment Guide"]
                    </a>
                    <a href="https://github.com/aiursoftweb/OllamaGateway" target="_blank" class="btn btn-outline-primary btn-lg btn-pill">
                        <i class="align-middle" data-lucide="github"></i> @Localizer["View on GitHub"]
                    </a>
                </div>
            </div>
            <div class="col-lg-7 d-none d-lg-flex mx-auto text-center">
                <div class="landing-intro-screenshot shadow-lg">
                    <img src="~/images/screenshot.png" alt="@Localizer["OllamaGateway main screenshot"]" class="img-fluid rounded" />
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-6">
    <div class="container">
        <div class="mb-5 text-center">
            <span class="text-uppercase text-primary text-sm fw-medium mb-1 d-block">@Localizer["Enterprise Ready"]</span>
            <h2 class="h1">@Localizer["Security and Auditing by Design."]</h2>
        </div>

        <div class="row">
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="shield-check"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Bearer Token Auth"]</h4>
                        <p class="fs-lg">@Localizer["Create multiple API keys for different users and applications, each with its own fine-grained permissions."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="database"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Clickhouse Auditing"]</h4>
                        <p class="fs-lg">@Localizer["Detailed auditing for every request and response, stored in high-performance Clickhouse storage for compliance."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="user-cog"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Team Management"]</h4>
                        <p class="fs-lg">@Localizer["A built-in Role-Based Access Control (RBAC) system for managing your team's access to AI models."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="zap"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Model Keep-alive"]</h4>
                        <p class="fs-lg">@Localizer["Periodically pings underlying models to ensure they stay loaded in memory for instant response times."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="cpu"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Default Model Support"]</h4>
                        <p class="fs-lg">@Localizer["Automatically redirect requests to a default virtual model if no model is specified in the API call."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="refresh-cw"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Native Passthrough"]</h4>
                        <p class="fs-lg">@Localizer["Seamless support for native Ollama features including MCP tools, embedding, images, and stream mode."]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<section class="immersive-section position-relative w-100 overflow-hidden d-flex align-items-center">
    
    <div class="immersive-bg">
        <div class="bg-image-wrapper">
             <img src="~/images/template_running_in_docker.webp" alt="@Localizer["OllamaGateway in Docker"]" class="img-fluid object-fit-cover w-100 h-100">
        </div>
        <div class="bg-overlay"></div>
    </div>

    <div class="container position-relative z-2 py-5">
        <div class="row">
            <div class="col-lg-6 offset-lg-6 col-md-12">
                
                <div class="mb-5 text-start ps-lg-4">
                    <div class="d-inline-flex align-items-center px-3 py-1 mb-3 rounded-pill border border-white-10 bg-dark-glass-sm backdrop-blur">
                        <span class="text-info me-2"><i class="fas fa-server"></i></span>
                        <span class="text-gray-300 small fw-medium text-uppercase tracking-wider">@Localizer["Smart Proxy"]</span>
                    </div>
                    <h2 class="display-4 fw-bold text-white mb-3">
                        <span class="text-primary">@Localizer["Intelligent"]</span><br>
                        @Localizer["Virtual Models"]
                    </h2>
                    <p class="lead text-gray-400 fs-5">
                        @Localizer["Create multiple aliases for your models with custom system prompts and parameter overrides."]
                    </p>
                </div>

                <div class="row g-3 ps-lg-4">
                    
                    @* Card 1: Chat Models *@
                    <div class="col-md-6">
                        <div class="card bg-dark-glass border-white-10 h-100 hover-lift">
                            <div class="card-body p-4">
                                <div class="icon-box-sm bg-success-subtle text-success rounded-3 me-3 mb-3">
                                    <i class="fas fa-comments fa-lg"></i>
                                </div>
                                <h5 class="fw-bold text-white fs-6">@Localizer["Chat Models"]</h5>
                                <p class="text-gray-400 mb-0 lh-sm"> @Localizer["Create virtual chat models with persistent system prompts."]</p>
                            </div>
                        </div>
                    </div>

                    @* Card 2: Embedding Models *@
                    <div class="col-md-6">
                         <div class="card bg-dark-glass border-white-10 h-100 hover-lift">
                            <div class="card-body p-4">
                                <div class="icon-box-sm bg-info-subtle text-info rounded-3 me-3 mb-3">
                                    <i class="fas fa-project-diagram fa-lg"></i>
                                </div>
                                <h5 class="fw-bold text-white fs-6">@Localizer["Embedding Models"]</h5>
                                <p class="text-gray-400 mb-0 lh-sm"> @Localizer["Dedicated management for embedding models for RAG applications."]</p>
                            </div>
                        </div>
                    </div>

                    @* Card 3: Full Control *@
                    <div class="col-12">
                        <div class="card bg-dark-glass border-white-10 h-100 hover-lift">
                            <div class="card-body p-4 d-flex align-items-center">
                                <div class="icon-box-sm bg-white-10 text-white rounded-3 me-3">
                                    <i class="fas fa-sliders-h"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold text-white mb-1 fs-6"> @Localizer["Parameter Overrides"]</h5>
                                    <p class="text-gray-400 mb-0">@Localizer["Override temperature, top_k, and other Ollama options per virtual model."]</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="card bg-dark-glass border-white-10 h-100 hover-lift text-center py-2">
                            <div class="card-body p-2">
                                <i class="fas fa-link text-warning mb-2 fs-5"></i>
                                <div class="text-gray-300 fw-bold" style="font-size: 0.75rem">@Localizer["Smart Mapping"]</div>
                                <div class="text-gray-500">@Localizer["Alias -> Real"]</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="card bg-dark-glass border-white-10 h-100 hover-lift text-center py-2">
                            <div class="card-body p-2">
                                <i class="fas fa-check-double text-primary mb-2 fs-5"></i>
                                <div class="text-gray-300 fw-bold" style="font-size: 0.75rem">@Localizer["Validation"]</div>
                                <div class="text-gray-500">@Localizer["Auto Sync"]</div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-6">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <div class="mb-4 text-start">
                    <span class="text-uppercase text-primary text-sm fw-medium mb-1 d-block">@Localizer["Agent & Ecosystem Ready"]</span>
                    <h2 class="h1">@Localizer["Perfect for Agent Deployment"]</h2>
                </div>
                <p class="fs-lg text-muted">@Localizer["OllamaGateway has been officially tested and is fully compatible with popular ecosystem tools including Claude Code, Open-WebUI, Opencode, and Roocode. Its robust API translation makes it the ideal choice for deploying autonomous AI agents."]</p>
            </div>
            <div class="col-lg-6">
                <div class="card bg-dark text-white border-0 shadow">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-3">
                            <i data-lucide="cpu" class="text-primary me-2"></i>
                            <h5 class="mb-0 fw-bold">@Localizer["Recommended Models"]</h5>
                        </div>
                        <ul class="list-unstyled mb-0 fs-lg">
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i> <code class="text-white bg-dark-glass px-2 py-1 rounded">qwen3.6:27b-q8_0</code></li>
                            <li><i class="fas fa-check text-success me-2"></i> <code class="text-white bg-dark-glass px-2 py-1 rounded">qwen3.6:35b-a3b-q4_K_M</code></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-6 bg-light">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0 order-lg-2">
                <div class="mb-4 text-start">
                    <span class="text-uppercase text-primary text-sm fw-medium mb-1 d-block">@Localizer["Native Power, AI Development"]</span>
                    <h2 class="h1">@Localizer["Supercharge AI Development with Claude Code, Opencode & Qwen Code"]</h2>
                    <p class="fs-lg text-muted mt-3">@Localizer["OllamaGateway seamlessly connects your local Ollama capabilities to professional AI development tools. Whether you are using Claude Code, Opencode or Qwen Code, you can now leverage your own hardware for automated coding and development tasks—all verified and officially supported by our team."]</p>
                </div>
                <div class="mt-4">
                    <ul class="list-unstyled fs-lg">
                        <li class="mb-2 d-flex align-items-center text-muted">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            <span>@Localizer["Verified compatibility with Claude Code agent"]</span>
                        </li>
                        <li class="mb-2 d-flex align-items-center text-muted">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            <span>@Localizer["Optimized for Opencode & Qwen Code ecosystems"]</span>
                        </li>
                        <li class="mb-2 d-flex align-items-center text-muted">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            <span>@Localizer["Secure local inference with zero data leakage"]</span>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-6 order-lg-1">
                <div class="shadow-lg rounded overflow-hidden">
                    <img src="~/images/opencode-qwencode-working.png" alt="@Localizer["Opencode and Qwen Code working with OllamaGateway"]" class="img-fluid" />
                </div>
            </div>
        </div>
    </div>
</section>

<section id="compatibility-reference" class="py-6 bg-dark text-white compatibility-section"
         data-compatibility-inbound-formats="4"
         data-compatibility-backend-protocols="3">
    <div class="container">
        <div class="mb-4 text-center">
            <span class="text-uppercase text-primary text-sm fw-medium mb-1 d-block">@Localizer["Cross-Protocol Compatibility"]</span>
            <h2 class="h1 text-white mb-3">@Localizer["Inspect one translation route at a time."]</h2>
            <div class="row justify-content-center mt-3">
                <div class="col-xl-8">
                    <p class="text-gray-400 fs-lg mb-0">
                        @Localizer["Choose the API your client sends on the left and the protocol spoken by the physical backend on the right. The active route shows exactly what is preserved, translated, rejected, and overridden."]
                    </p>
                </div>
            </div>
        </div>

        <ul class="nav compatibility-tabs mb-4" id="compatibilityTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="compatibility-chat-tab" data-bs-toggle="tab" data-bs-target="#compatibility-chat" type="button" role="tab" aria-controls="compatibility-chat" aria-selected="true">
                    <span class="compatibility-tab-icon"><i class="fas fa-comments"></i></span>
                    <span><strong>@Localizer["Chat"]</strong><small>@Localizer["4 client dialects × 3 backend protocols"]</small></span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="compatibility-embedding-tab" data-bs-toggle="tab" data-bs-target="#compatibility-embedding" type="button" role="tab" aria-controls="compatibility-embedding" aria-selected="false">
                    <span class="compatibility-tab-icon"><i class="fas fa-cubes"></i></span>
                    <span><strong>@Localizer["Embedding"]</strong><small>@Localizer["2 client dialects × 2 Provider types"]</small></span>
                </button>
            </li>
        </ul>

        <div class="tab-content" id="compatibilityTabContent">
            <div class="tab-pane fade show active" id="compatibility-chat" role="tabpanel" aria-labelledby="compatibility-chat-tab" tabindex="0">
        <div class="compatibility-workbench p-3 p-lg-4 mb-4" data-compatibility-matrix="semantic-ir-v2">
            <div class="row g-3 g-lg-4 align-items-stretch">
                <div class="col-12 col-lg-3 order-1">
                    <div class="compatibility-selector h-100">
                        <div class="compatibility-selector-label"><span>01</span>@Localizer["Requester's API"]</div>
                        <div class="d-grid gap-2" role="group" aria-label="@Localizer["Select requester API"]">
                            <button type="button" class="compatibility-choice active" data-compatibility-source="ollama" data-endpoint="/api/chat" data-label="Ollama Chat" aria-pressed="true">
                                <i class="fas fa-terminal"></i><span><strong>Ollama Chat</strong><small>/api/chat</small></span>
                            </button>
                            <button type="button" class="compatibility-choice" data-compatibility-source="openai-chat" data-endpoint="/v1/chat/completions" data-label="OpenAI Chat" aria-pressed="false">
                                <i class="fas fa-comments"></i><span><strong>OpenAI Chat</strong><small>/v1/chat/completions</small></span>
                            </button>
                            <button type="button" class="compatibility-choice" data-compatibility-source="openai-responses" data-endpoint="/v1/responses" data-label="OpenAI Responses" aria-pressed="false">
                                <i class="fas fa-stream"></i><span><strong>OpenAI Responses</strong><small>/v1/responses · @Localizer["state-aware"]</small></span>
                            </button>
                            <button type="button" class="compatibility-choice" data-compatibility-source="anthropic" data-endpoint="/v1/messages" data-label="Anthropic Messages" aria-pressed="false">
                                <i class="fas fa-message"></i><span><strong>Anthropic Messages</strong><small>/v1/messages</small></span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-6 order-3 order-lg-2">
                    <div class="compatibility-stage state-transparent h-100"
                         data-compatibility-stage
                         data-native-label="@Localizer["Native / same dialect"]"
                         data-translated-label="@Localizer["Translated through semantic layer"]"
                         data-native-summary="@Localizer["The gateway keeps the protocol shape and rewrites only gateway-owned values and configured policy fields."]"
                         data-translated-summary="@Localizer["The gateway decodes both sides through its canonical chat model. Only semantics representable by the target protocol can cross this route."]"
                         aria-live="polite">
                        <div class="compatibility-stage-grid" aria-hidden="true"></div>
                        <div class="compatibility-route-kicker">@Localizer["Active route"] <span data-route-number>01 / 12</span></div>
                        <div class="compatibility-signal" aria-hidden="true">
                            <span class="compatibility-signal-node"><i class="fas fa-code"></i></span>
                            <span class="compatibility-signal-line"><span></span></span>
                            <span class="compatibility-signal-core"><i class="fas fa-bolt"></i></span>
                            <span class="compatibility-signal-line"><span></span></span>
                            <span class="compatibility-signal-node"><i class="fas fa-server"></i></span>
                        </div>
                        <div class="row g-2 text-center position-relative">
                            <div class="col-5">
                                <small class="text-gray-500 d-block">@Localizer["Client"]</small>
                                <strong class="text-white d-block" data-route-source-label>Ollama Chat</strong>
                                <code data-route-source-endpoint>/api/chat</code>
                            </div>
                            <div class="col-2 d-flex justify-content-center align-items-center">
                                <i class="fas fa-arrow-right compatibility-direction-icon"></i>
                            </div>
                            <div class="col-5">
                                <small class="text-gray-500 d-block">@Localizer["Backend"]</small>
                                <strong class="text-white d-block" data-route-target-label>Ollama Native</strong>
                                <code data-route-target-endpoint>/api/chat</code>
                            </div>
                        </div>
                        <div class="text-center position-relative mt-4">
                            <span class="compatibility-mode-badge" data-route-mode>@Localizer["Native / same dialect"]</span>
                            <p class="small text-gray-400 mt-3 mb-0" data-route-summary>@Localizer["The gateway keeps the protocol shape and rewrites only gateway-owned values and configured policy fields."]</p>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-3 order-2 order-lg-3">
                    <div class="compatibility-selector h-100">
                        <div class="compatibility-selector-label"><span>02</span>@Localizer["Physical backend protocol"]</div>
                        <div class="d-grid gap-2" role="group" aria-label="@Localizer["Select backend protocol"]">
                            <button type="button" class="compatibility-choice active" data-compatibility-target="ollama" data-endpoint="/api/chat" data-label="Ollama Native" aria-pressed="true">
                                <i class="fas fa-server"></i><span><strong>Ollama Native</strong><small>/api/chat</small></span>
                            </button>
                            <button type="button" class="compatibility-choice" data-compatibility-target="openai-chat" data-endpoint="/v1/chat/completions" data-label="OpenAI Chat" aria-pressed="false">
                                <i class="fas fa-comments"></i><span><strong>OpenAI Chat</strong><small>/v1/chat/completions</small></span>
                            </button>
                            <button type="button" class="compatibility-choice" data-compatibility-target="openai-responses" data-endpoint="/v1/responses" data-label="OpenAI Responses" aria-pressed="false">
                                <i class="fas fa-stream"></i><span><strong>OpenAI Responses</strong><small>/v1/responses</small></span>
                            </button>
                        </div>
                        <p class="small text-gray-500 mt-3 mb-0">@Localizer["Provider type and backend protocol are separate. No physical Anthropic backend adapter exists today."]</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="compatibility-active-contract mb-4" data-active-route-contract>
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
                <div>
                    <span class="compatibility-eyebrow">@Localizer["Current route contract"]</span>
                    <h3 class="h4 text-white mb-0" data-route-title>Ollama → Ollama</h3>
                </div>
                <small class="text-gray-500">@Localizer["Only the selected route is shown"]</small>
            </div>
            <div class="compatibility-method mb-3">
                <div class="compatibility-contract-icon"><i class="fas fa-code-branch"></i></div>
                <div><span>@Localizer["Implementation method"]</span><div data-route-method></div></div>
            </div>
            <div class="row g-3">
                <div class="col-12 col-lg-6">
                    <article class="compatibility-contract-card contract-preserved h-100">
                        <h4><i class="fas fa-check-circle"></i>@Localizer["Preserved"]</h4>
                        <div data-route-preserved></div>
                    </article>
                </div>
                <div class="col-12 col-lg-6">
                    <article class="compatibility-contract-card contract-mapped h-100">
                        <h4><i class="fas fa-random"></i>@Localizer["Mapped / reconstructed"]</h4>
                        <div data-route-mapped></div>
                    </article>
                </div>
                <div class="col-12 col-lg-6">
                    <article class="compatibility-contract-card contract-discarded h-100">
                        <h4><i class="fas fa-times-circle"></i>@Localizer["Discarded, rejected, or preferred"]</h4>
                        <div data-route-discarded></div>
                    </article>
                </div>
                <div class="col-12 col-lg-6">
                    <article class="compatibility-contract-card contract-database h-100">
                        <h4><i class="fas fa-database"></i>@Localizer["Database override"]</h4>
                        <div data-route-database></div>
                    </article>
                </div>
            </div>
        </div>

        <div class="d-none" aria-hidden="true" data-route-catalog>
            <table class="table table-bordered table-dark table-sm mb-0 align-top compatibility-table compatibility-detail" data-translation-directions="12" style="min-width: 1900px;">
                <thead class="align-middle text-center">
                    <tr>
                        <th style="width: 12%;">@Localizer["Direction"]</th>
                        <th style="width: 18%;">@Localizer["Implementation method"]</th>
                        <th style="width: 19%;"><i class="fas fa-check-circle text-success me-1"></i>@Localizer["Preserved"]</th>
                        <th style="width: 21%;"><i class="fas fa-random text-info me-1"></i>@Localizer["Mapped / reconstructed"]</th>
                        <th style="width: 16%;"><i class="fas fa-times-circle text-danger me-1"></i>@Localizer["Discarded, rejected, or preferred"]</th>
                        <th style="width: 14%;"><i class="fas fa-database text-warning me-1"></i>@Localizer["Database override"]</th>
                    </tr>
                </thead>
                <tbody class="small">
                    <tr class="compatibility-group compatibility-group-ollama">
                        <th colspan="6"><i class="fas fa-server me-2"></i>@Localizer["Ollama Chat client routes"] <span class="fw-normal opacity-75 ms-2"><code>/api/chat</code> → @Localizer["3 backend protocols"]</span></th>
                    </tr>
