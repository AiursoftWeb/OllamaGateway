<div class="form-text mb-3" data-utc-input-note>
    <span data-key="utc-input-time">@Localizer["Enter times in UTC."]</span>
    <span data-key="local-input-time" hidden>@Localizer["Times are in your device's time zone."]</span>
    <span data-key="invalid-local-time" hidden>@Localizer["This local time does not exist because the clocks change. Choose another time."]</span>
</div>
<script src="~/scripts/utc-input.js" asp-append-version="true" defer></script>
