@using System.Text.Json
@using Aiursoft.OllamaGateway.Views.Shared.Components.LiveInference
@model LiveInferenceViewModel

<div class="card flex-fill w-100" id="live-inference"
     data-socket-url="@Url.Action("LiveInferenceSocket", "Dashboard")"
     data-initial-state="@JsonSerializer.Serialize(Model, JsonSerializerOptions.Web)"
     data-busy="@Localizer["Busy"]" data-idle="@Localizer["Idle"]" data-active="@Localizer["Active"]"
     data-running="@Localizer["Running for"]" data-last="@Localizer["Last at"]"
     data-anonymous="@Localizer["(anonymous)"]" data-no-content="@Localizer["(no content)"]"
     data-question-title="@Localizer["Full Request Message"]" data-answer-title="@Localizer["Answer or error"]"
     data-connecting="@Localizer["Connecting…"]" data-reconnecting="@Localizer["Reconnecting…"]">
    <div class="card-header d-flex align-items-center gap-2">
        <h5 class="card-title mb-0 flex-grow-1">
            <i class="align-middle me-1" data-lucide="zap"></i> @Localizer["Live Inference"]
        </h5>
        <span class="text-muted small" data-connection-status role="status"></span>
        <span class="badge" data-active-count></span>
    </div>
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>@Localizer["Status"]</th>
                    <th>@Localizer["Virtual Model"]</th>
                    <th>@Localizer["Backend Model"]</th>
                    <th class="text-center">@Localizer["Concurrent Requests"]</th>
                    <th>@Localizer["API Key"]</th>
                    <th>@Localizer["Last Question (first 30 chars)"]</th>
                    <th>@Localizer["Answer or error"]</th>
                    <th class="text-end">@Localizer["Time"]</th>
                </tr>
            </thead>
            <tbody data-live-rows></tbody>
            <tbody data-live-empty hidden>
                <tr><td colspan="8" class="text-center text-muted py-3">@Localizer["No active inference requests — all models are idle"]</td></tr>
            </tbody>
        </table>
    </div>
    <template data-live-row>
        <tr>
            <td><span class="badge" data-field="status"></span></td>
            <td data-field="model"></td>
            <td class="text-muted small font-monospace" data-field="backend"></td>
            <td class="text-center"><span class="badge" data-field="count"></span></td>
            <td class="text-muted small" data-field="key"></td>
            <td class="font-monospace text-muted small"><button type="button" class="btn btn-link btn-sm text-start text-break p-0" data-field="question"></button></td>
            <td class="font-monospace small"><button type="button" class="btn btn-link btn-sm text-start text-break p-0" data-field="answer"></button></td>
            <td class="text-end text-muted small" data-field="time"></td>
        </tr>
    </template>
</div>

<div class="modal fade" id="liveInferenceFullMessageModal" tabindex="-1" aria-labelledby="liveInferenceFullMessageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="liveInferenceFullMessageModalLabel"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Close"]"></button>
            </div>
            <div class="modal-body">
                <pre class="bg-body-tertiary p-3 rounded mb-0 text-wrap text-break" id="liveInferenceFullMessageContent"></pre>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Close"]</button>
            </div>
        </div>
    </div>
</div>
<script src="~/js/live-inference.js" asp-append-version="true" defer></script>
