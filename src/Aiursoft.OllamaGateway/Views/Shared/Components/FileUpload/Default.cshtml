@using Aiursoft.OllamaGateway.Services.FileStorage
@model Aiursoft.OllamaGateway.Views.Shared.Components.FileUpload.FileUploadViewModel
@inject IViewLocalizer Localizer
@inject StorageService Storage
@inject IHtmlGenerator HtmlGenerator
@{
    var fileInputId = $"file-input-{Model.UniqueId}";
    var progressId = $"progress-{Model.UniqueId}";
    var progressbarId = $"progressbar-{Model.UniqueId}";
    var configId = $"file-upload-config-{Model.UniqueId}";

    var extensionAttributes = " ";
    if (!string.IsNullOrWhiteSpace(Model.AllowedExtensions))
    {
        extensionAttributes += $"data-allowed-file-extensions=\"{Model.AllowedExtensions}\" ";
    }
    var defaultValue = Model.AspFor.Model as string;
    if (!string.IsNullOrWhiteSpace(defaultValue))
    {
        extensionAttributes += $"data-default-file=\"{Storage.RelativePathToInternetUrl(defaultValue, Model.IsVault)}\" ";
    }
    if (Model.MaxSizeInMb > 0)
    {
        extensionAttributes += $"data-max-file-size=\"{Model.MaxSizeInMb}M\"";
    }

    // Use custom FieldName if provided, otherwise use AspFor.Name
    var fieldName = Model.FieldName ?? Model.AspFor.Name;
    
    var hiddenInputTag = HtmlGenerator.GenerateTextBox(
        ViewContext,
        Model.AspFor.ModelExplorer,
        fieldName,  // Use the override name if provided
        Model.AspFor.Model,
        format: null,
        htmlAttributes: new { style = "width:0;height:0;padding:0;border:none;" });
}

<input
    form="fakeForm"
    type="file"
    id="@fileInputId"
    class="dropify"
    data-show-remove="false"
    @Html.Raw(extensionAttributes) />
<div id="@progressId" class="progress mb-3 mt-3 d-none">
    <div id="@progressbarId" class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar"></div>
</div>
@hiddenInputTag

<!-- Localization and server-rendered data for JavaScript -->
<div id="@configId"
     class="file-upload-config"
     data-file-input-id="@fileInputId"
     data-progress-id="@progressId"
     data-progressbar-id="@progressbarId"
     data-field-name="@fieldName"
     data-size-in-mb="@Model.MaxSizeInMb"
     data-valid-extensions="@Model.AllowedExtensions"
     data-upload-url="@Model.UploadEndpoint"
     hidden>
    <span data-key="default">@Localizer["Drag and drop a file here or click"]</span>
    <span data-key="replace">@Localizer["Drag and drop or click to replace"]</span>
    <span data-key="remove">@Localizer["Remove"]</span>
    <span data-key="error">@Localizer["Oops, something went wrong."]</span>
    <span data-key="file-size">@Localizer["The file size is too big ({{{{ value }}}} max)."]</span>
    <span data-key="min-width">@Localizer["The image width is too small ({{{{ value }}}}px min)."]</span>
    <span data-key="max-width">@Localizer["The image width is too big ({{{{ value }}}}px max)."]</span>
    <span data-key="min-height">@Localizer["The image height is too small ({{{{ value }}}}px min)."]</span>
    <span data-key="max-height">@Localizer["The image height is too big ({{{{ value }}}}px max)."]</span>
    <span data-key="image-format">@Localizer["The image format is not allowed ({{{{ value }}}} only)."]</span>
    <span data-key="file-extension">@Localizer["The file is not allowed ({{{{ value }}}} only)."]</span>
    <span data-key="upload-in-progress">@Localizer["Your file is still uploading. Are you sure you want to leave?"]</span>
</div>

<script type="module">
    import Uploader from "/scripts/uploader.js";
    window.addEventListener('load', function () {
        document.querySelectorAll('.file-upload-config:not([data-initialized])').forEach(function (config) {
            config.dataset.initialized = 'true';
            const getText = (key) => config.querySelector(`span[data-key="${key}"]`).innerText;
            const addressElement = document.getElementsByName(config.dataset.fieldName)[0];

            new Uploader({
                fileInput: $('#' + config.dataset.fileInputId),
                progress: $('#' + config.dataset.progressId),
                progressbar: $('#' + config.dataset.progressbarId),
                addressInput: $(addressElement),
                sizeInMb: Number(config.dataset.sizeInMb),
                validExtensions: (config.dataset.validExtensions || '').split(' ').filter(Boolean),
                uploadUrl: config.dataset.uploadUrl,
                uploadInProgressMessage: getText('upload-in-progress')
            }).init({
                messages: {
                    'default': getText('default'),
                    'replace': getText('replace'),
                    'remove': getText('remove'),
                    'error': getText('error')
                },
                error: {
                    'fileSize': getText('file-size'),
                    'minWidth': getText('min-width'),
                    'maxWidth': getText('max-width'),
                    'minHeight': getText('min-height'),
                    'maxHeight': getText('max-height'),
                    'imageFormat': getText('image-format'),
                    'fileExtension': getText('file-extension')
                }
            });
        });
    })
</script>
